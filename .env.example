# Core runtime
DEMO_MODE=true
AUTO_FOLLOWUP_ENABLED=true
FOLLOWUP_POLL_SECONDS=15
DATABASE_URL=sqlite+aiosqlite:///./followup.db
SECRET_KEY=replace-with-long-random-secret
CLINIC_ACCESS_CODE=CLINIC-DEMO
CLINIC_NAME=SaiDatta Dental Clinic

# Azure OpenAI - optional locally. When set, treatment/general replies can be personalized by Azure OpenAI.
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_KEY=
AZURE_OPENAI_DEPLOYMENT=followup-gpt
AZURE_OPENAI_API_VERSION=2024-10-21

# Azure Communication Services. Without credentials/phone numbers, outbound SMS/voice is simulated and still logged.
AZURE_COMMUNICATION_CONNECTION_STRING=
AZURE_SMS_FROM_NUMBER=
AZURE_CALLER_ID=
AZURE_CALL_CALLBACK_URL=

# Azure Blob Storage - ready for future patient files/audio
AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_CONTAINER=patient-files
